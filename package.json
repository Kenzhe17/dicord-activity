{
  "name": "rize3-arcade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @rize/web --filter @rize/server dev",
    "build": "pnpm --filter @rize/web build && pnpm --filter @rize/server build",
    "start": "pnpm --filter @rize/server start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node tooling/test.mjs",
    "test:watch": "node tooling/test.mjs --watch",
    "test:e2e": "playwright test",
    "test:durak:sim": "tsx tooling/simulate-durak.ts 10000",
    "db:validate": "pnpm --filter @rize/database validate",
    "db:generate": "pnpm --filter @rize/database generate",
    "db:local": "node tooling/local-postgres.mjs",
    "db:migrate:local": "node tooling/migrate-local.mjs",
    "db:migrate:test": "node tooling/migrate-local.mjs --test",
    "check": "pnpm db:validate && pnpm db:generate && pnpm typecheck && pnpm lint && pnpm check:boundaries && pnpm test && pnpm build",
    "check:boundaries": "node tooling/check-boundaries.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^10.14.0",
    "fast-check": "^4.3.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.18"
  }
}
