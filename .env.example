# Discord Application Configuration
# Получите эти значения в Discord Developer Portal: https://discord.com/developers/applications
DISCORD_CLIENT_ID=1566376251185168394
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=https://your-app-name.railway.app

# Server Configuration
PORT=3001
CORS_ORIGIN=https://your-app-name.railway.app

# PostgreSQL Database (shared with another bot)
# Get this from Railway Dashboard of your PostgreSQL service
DATABASE_URL=postgresql://user:password@host:port/database

# Для локальной разработки с Cloudflare Tunnel
# PORT=3001
# CORS_ORIGIN=http://localhost:5173
# DISCORD_REDIRECT_URI=http://localhost:5173
